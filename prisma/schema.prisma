generator client {
  provider = "prisma-client-js"
}

// Switch provider to "postgresql" and point DATABASE_URL at Neon/Supabase for production.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Barber {
  id           String         @id @default(cuid())
  slug         String         @unique
  name         String
  title        String
  bio          String
  avatarUrl    String?
  active       Boolean        @default(true)
  sortOrder    Int            @default(0)
  workingHours WorkingHours[]
  bookings     Booking[]
  createdAt    DateTime       @default(now())
}

model Service {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String
  durationMin Int
  priceCents  Int
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  bookings    Booking[]
  createdAt   DateTime  @default(now())
}

/// Times are "HH:mm" in the shop's local time zone (see src/config/shop.ts).
model WorkingHours {
  id        String @id @default(cuid())
  barberId  String
  barber    Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)
  weekday   Int
  startTime String
  endTime   String

  @@unique([barberId, weekday])
}

/// status: PENDING | CONFIRMED | DECLINED | CANCELLED
model Booking {
  id            String   @id @default(cuid())
  code          String   @unique
  barberId      String
  barber        Barber   @relation(fields: [barberId], references: [id])
  serviceId     String
  service       Service  @relation(fields: [serviceId], references: [id])
  customerName  String
  customerPhone String
  customerEmail String?
  note          String?
  startAt       DateTime
  endAt         DateTime
  status        String   @default("PENDING")
  decisionNote  String?
  decidedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([barberId, startAt])
  @@index([status])
}
